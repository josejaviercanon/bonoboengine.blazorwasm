@page "/examples/{*ExampleId}"
@using System.Text.Json
@using Game.Examples
@using Game.Engine.ECS
@inject EcsSimulation Ecs
@inject SnakeSimulation Snake
@inject TetrisSimulation Tetris

@code {
    [Parameter] public string ExampleId { get; set; } = string.Empty;
}

@{
    var example = ExamplesCatalog.Find(ExampleId);
    var jsonOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web);
    var payload = example switch
    {
        null => string.Empty,
        { Id: "ecs/sprites" } => JsonSerializer.Serialize(
            new ExamplePayload(example.Id, example.Title, example.SourceUrl, Ecs.Snapshot(), "/api/ecs/stream"),
            jsonOptions),
        { Id: "games/snake" } => JsonSerializer.Serialize(
            new ExamplePayload(example.Id, example.Title, example.SourceUrl,
                Snake: new SnakeScenePayload(Snake.Snapshot(), Snake.Score, Snake.IsGameOver, Snake.IsStarted,
                    SnakeSimulation.GridWidth, SnakeSimulation.GridHeight, SnakeSimulation.CellSize, "/api/snake/stream")),
            jsonOptions),
        { Id: "games/tetris" } => JsonSerializer.Serialize(
            new ExamplePayload(example.Id, example.Title, example.SourceUrl,
                Tetris: new TetrisScenePayload(Tetris.Snapshot(), Tetris.Score, Tetris.Rows, Tetris.Level,
                    Tetris.IsGameOver, Tetris.IsStarted,
                    TetrisSimulation.GridWidth, TetrisSimulation.GridHeight, TetrisSimulation.CellSize, "/api/tetris/stream")),
            jsonOptions),
        _ => JsonSerializer.Serialize(new ExamplePayload(example.Id, example.Title, example.SourceUrl), jsonOptions),
    };
}

<div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-color: #020617; overflow: hidden; z-index: 1;">

    <ExampleToolbar CurrentId="@ExampleId" />

    @if (example is null)
    {
        <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #f87171; font-size: 1.25rem;">
            Unknown example: @ExampleId
        </div>
    }
    else
    {
        <div id="pixi-viewport" data-message="@payload" style="position: absolute; top: 52px; left: 0; right: 0; bottom: 0; display: block; z-index: 2;"></div>
    }

</div>
