@page "/"
@page "/examples"

<div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-color: #020617; overflow: hidden; z-index: 1;">
    <ExampleToolbar CurrentId="" />
    <div style="position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; color: #e2e8f0;">
        <h1 style="margin: 0; font-size: 1.75rem; color: #34d399;">PixiJS Examples</h1>
        <p style="margin: 0; color: #94a3b8; font-size: 0.9rem;">Pick an example or a game from the toolbar to render it.</p>
    </div>
</div>
