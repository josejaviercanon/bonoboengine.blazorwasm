<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <!-- Link your Tailwind CSS layout bundle -->
    <link rel="stylesheet" href="_content/Game.UI/dist/app.css" />
    <link rel="stylesheet" href="@Assets["Game.Web.styles.css"]" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body class="bg-slate-950 m-0 p-0 overflow-hidden">
    <Routes />

    <!-- Use the direct physical static web asset path to guarantee global scope registration.
         ES module: required because the Rapier wasm wrapper uses top-level await. -->
    <script type="module" src="_content/Game.UI/dist/game-bundle.js"></script>

    <!--
        Static-SSR bootstrap: no server circuit, no SignalR, no reconnect modal.
        GameView / ExampleHost render a message into #pixi-viewport[data-message] server-side;
        this script starts PixiJS once the page has loaded and renders the payload
        (plain text for "/", or an example scene for "/examples/{id}").
    -->
    <script>
        function startPixi() {
            var viewport = document.getElementById('pixi-viewport');
            if (!viewport) {
                console.warn('[pixi-debug] #pixi-viewport NOT found in DOM');
                return;
            }
            var message = viewport.getAttribute('data-message') || '';
            console.log('[pixi-debug] #pixi-viewport found, data-message =', JSON.stringify(message));
            initGame('pixi-viewport')
                .then(function () {
                    console.log('[pixi-debug] initGame resolved, calling renderScene(message)');
                    if (typeof renderScene !== 'function') {
                        console.error('[pixi-debug] renderScene is not defined');
                        return;
                    }
                    renderScene(message);
                })
                .catch(function (err) {
                    console.error('[pixi-debug] initGame failed:', err);
                });
        }

        window.addEventListener('load', function () {
            console.log('[pixi-debug] window load fired');
            // game-bundle.js is an ES module with dynamic imports (PixiJS chunks,
            // optional Rapier wasm): its execution can finish AFTER the load event.
            // Poll until initGame is exposed instead of failing fast.
            var attempts = 0;
            (function waitForBundle() {
                if (typeof initGame === 'function') {
                    startPixi();
                } else if (++attempts < 300) { // ~15 s max at 50 ms intervals
                    setTimeout(waitForBundle, 50);
                } else {
                    console.error('[pixi-debug] initGame is not defined after 15s - game-bundle may have failed to load');
                }
            })();
        });
    </script>
</body>

</html>
